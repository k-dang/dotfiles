{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["@plannotator/opencode@latest"],
  "mcp": {
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "opensrc": {
      "type": "local",
      "command": ["npx", "-y", "opensrc-mcp"],
      "enabled": true,
    },
  },
}
