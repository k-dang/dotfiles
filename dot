#!/usr/bin/env bash

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'
readonly BOLD='\033[1m'

# Script metadata
readonly SCRIPT_NAME="dot"
readonly VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Defaults (can be overridden by flags)
DOTFILES_DIR="$SCRIPT_DIR"
SKILL_DIRS=(".claude/skills" ".agents/skills")

print_header() {
    printf "\n${BOLD}${BLUE}==>${RESET} ${BOLD}%s${RESET}\n" "$1"
}

print_success() {
    printf "${GREEN}✓${RESET} %s\n" "$1"
}

print_error() {
    printf "${RED}✗${RESET} %s\n" "$1" >&2
}

print_warning() {
    printf "${YELLOW}⚠${RESET} %s\n" "$1"
}

print_info() {
    printf "${CYAN}ℹ${RESET} %s\n" "$1"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

die() {
    print_error "$1"
    exit 1
}

install_tools() {
    local tools_script="${DOTFILES_DIR}/modules/tools.sh"
    if [[ -f "$tools_script" ]]; then
        print_header "Installing tools"
        # shellcheck disable=SC1090
        source "$tools_script"
        print_success "Tools installation complete"
    else
        print_warning "Tools script not found at ${tools_script}"
    fi
}

stow_dotfiles() {
    local mode="${1:-routine}"
    local home_dir="${DOTFILES_DIR}/home"

    if ! command_exists stow; then
        print_warning "GNU stow not found. Skipping ~/.config symlink management."
        print_info "Install stow for automatic ~/.config management: brew install stow"
        print_info "Or manually copy files from ${DOTFILES_DIR}/home/.config/ to ~/.config/"
        return 0
    fi

    if [[ ! -d "$home_dir" ]]; then
        print_warning "No home directory to stow at ${home_dir}"
        return 0
    fi

    print_header "Stowing configuration files"

    # Stow only manages paths present under home/. Init performs a non-destructive
    # initial stow and fails on conflicts with existing real files. Routine runs
    # use `--restow` to refresh symlinks already managed by stow. Unrelated files
    # in ~/.config are left alone.

    local stow_args=(--target="$HOME" --no-folding -d "$DOTFILES_DIR")

    if [[ "$mode" != "init" ]]; then
        stow_args+=(--restow)
    fi

    if stow "${stow_args[@]}" home; then
        print_success "Successfully stowed dotfiles from ${home_dir}"
    else
        print_warning "Stow command failed, likely due to an existing conflicting file in \$HOME"
        print_info "Resolve the conflict manually, then rerun: ${SCRIPT_NAME} stow"
    fi
}

setup_shell() {
    local zshrc="$HOME/.zshrc"
    local dotfiles_line='source "$HOME/dotfiles/shell/zsh.sh"'

    print_header "Configuring shell"

    if [[ -f "$zshrc" ]]; then
        if grep -q "$dotfiles_line" "$zshrc"; then
            print_success ".zshrc already sources dotfiles"
            return 0
        fi
        local backup_file
        backup_file="$HOME/.zshrc.backup.$(date +%Y%m%d_%H%M%S)"
        print_info "Backing up existing .zshrc to ${backup_file}"
        cp "$zshrc" "$backup_file"
    fi

    print_info "Appending dotfiles to .zshrc"
    {
        printf "\n# Dotfiles\n"
        printf "%s\n" "$dotfiles_line"
    } >>"$zshrc"
    print_success "Shell configured"
}

chmod_bin_scripts() {
    local bin_dir="${DOTFILES_DIR}/bin"
    if [[ -d "$bin_dir" ]]; then
        print_header "Making bin scripts executable"
        shopt -s nullglob
        local scripts=("$bin_dir"/*.sh)
        shopt -u nullglob
        if [[ ${#scripts[@]} -gt 0 ]]; then
            chmod +x "${scripts[@]}"
            print_success "Updated executable permissions"
        else
            print_info "No .sh scripts found in ${bin_dir}"
        fi
    fi
}

cmd_init() {
    print_header "Initializing dotfiles"
    install_tools
    stow_dotfiles init
    setup_shell
    chmod_bin_scripts
    print_header "Initialization complete!"
    print_info "Restart your terminal or run: source ~/.zshrc"
}

cmd_doctor() {
    print_header "Running diagnostics"
    local issues=0

    if command_exists git; then
        print_success "git available"
    else
        print_error "git not found"
        ((++issues))
    fi

    if command_exists stow; then
        print_success "GNU stow installed"
    else
        print_warning "GNU stow not installed"
    fi

    if [[ -d "$DOTFILES_DIR" ]]; then
        print_success "Dotfiles directory: ${DOTFILES_DIR}"
    else
        print_error "Dotfiles directory missing: ${DOTFILES_DIR}"
        ((++issues))
    fi

    if [[ -f "$HOME/.zshrc" ]]; then
        local dotfiles_line='source "$HOME/dotfiles/shell/zsh.sh"'
        if grep -q "$dotfiles_line" "$HOME/.zshrc"; then
            print_success ".zshrc sources dotfiles"
        else
            print_warning ".zshrc does not source dotfiles"
        fi
    else
        print_warning "~/.zshrc not found"
    fi

    if [[ $issues -eq 0 ]]; then
        print_header "All critical checks passed"
    else
        print_header "Found ${issues} critical issues"
    fi
}

cmd_stow() {
    stow_dotfiles routine
}

# A skill is stale when it is installed under $HOME but missing from home/. Without
# a source directory there is nothing to compare against, so nothing is stale.
is_stale_skill() {
    local source="${DOTFILES_DIR}/home/$1"
    [[ -d "$source" && -e "${HOME}/$1/$2" && ! -e "${source}/$2" ]]
}

# Prints one line per stale skill: the name padded to a column, then the
# top-level directories (.claude, .agents) it is installed in.
list_stale_skills() {
    local rel dir name
    for rel in "${SKILL_DIRS[@]}"; do
        # The glob skips dot-prefixed folders such as .trash, which are not skills.
        for dir in "${HOME}/${rel}"/*/; do
            name="$(basename "$dir")"
            if is_stale_skill "$rel" "$name"; then
                printf "%s\t%s\n" "$name" "${rel%%/*}"
            fi
        done
    done | sort | awk -F'\t' '
        !($1 in locations) { names[n++] = $1; locations[$1] = $2; if (length($1) > width) width = length($1); next }
        { locations[$1] = locations[$1] " " $2 }
        END { for (i = 0; i < n; i++) printf "%-" width "s  %s\n", names[i], locations[names[i]] }
    '
}

cmd_prune() {
    local dry_run=false
    case "${1:-}" in
        "") ;;
        --dry-run) dry_run=true ;;
        *) die "Unexpected argument for prune: $1" ;;
    esac

    print_header "Finding skills not in home/"

    local stale
    stale="$(list_stale_skills)"
    if [[ -z "$stale" ]]; then
        print_success "No stale skills found"
        return 0
    fi

    if $dry_run; then
        printf "%s\n" "$stale" | sed 's/^/  /'
        print_info "No files were deleted"
        return 0
    fi

    command_exists gum || die "gum not found. Install it with: brew install gum"

    local chosen
    chosen="$(printf "%s\n" "$stale" | gum choose --no-limit --header "Select skills to delete")" || true
    if [[ -z "$chosen" ]]; then
        print_info "No skills deleted"
        return 0
    fi

    local count=0 label name rel
    while IFS= read -r label; do
        name="${label%% *}"
        for rel in "${SKILL_DIRS[@]}"; do
            if is_stale_skill "$rel" "$name"; then
                rm -rf "${HOME:?}/${rel}/${name}"
            fi
        done
        ((++count))
    done <<<"$chosen"

    print_success "Deleted ${count} skill(s)"
}

cmd_help() {
    printf "${BOLD}%s${RESET} - Dotfiles management tool\n" "$SCRIPT_NAME"
    printf "Version: %s\n\n" "$VERSION"

    printf "${BOLD}USAGE:${RESET}\n"
    printf "    %s [OPTIONS] COMMAND [ARGS]\n\n" "$SCRIPT_NAME"

    printf "${BOLD}COMMANDS:${RESET}\n"
    printf "    init                Initialize dotfiles without adopting existing config files\n"
    printf "    doctor              Run diagnostics and check installation\n"
    printf "    stow                Create symlinks for dotfiles using GNU Stow\n"
    printf "    prune [--dry-run]   Pick installed skills that are not in home/ to delete\n"
    printf "    help                Show this help message (default)\n\n"

    printf "${BOLD}OPTIONS:${RESET}\n"
    printf "    --dotfiles-dir PATH  Override dotfiles directory (default: script location)\n"
    printf "    --version            Show version information\n"
    printf "    -h, --help           Show this help message\n\n"

    printf "${BOLD}EXAMPLES:${RESET}\n"
    printf "    %s init\n" "$SCRIPT_NAME"
    printf "    %s stow\n" "$SCRIPT_NAME"
    printf "\n"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dotfiles-dir)
                DOTFILES_DIR="$2"
                shift 2
                ;;
            --version)
                printf "%s version %s\n" "$SCRIPT_NAME" "$VERSION"
                exit 0
                ;;
            -h|--help)
                cmd_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)
            cmd_init "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        stow)
            cmd_stow "$@"
            ;;
        prune)
            cmd_prune "$@"
            ;;
        help)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $cmd"
            printf "Run '%s help' for usage information\n" "$SCRIPT_NAME"
            exit 1
            ;;
    esac
}

main "$@"
