#!/usr/bin/env bash

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'
readonly BOLD='\033[1m'

# Script metadata
readonly SCRIPT_NAME="dot"
readonly VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Defaults (can be overridden by flags)
DOTFILES_DIR="$SCRIPT_DIR"
DOTFILES_REPO_URL="https://github.com/k-dang/dotfiles.git"
SKIP_TOOLS=false
SKIP_STOW=false
SKIP_SHELL=false
NO_CLONE=false

# Paths
PACKAGES_DIR=""
HOME_DIR=""

print_header() {
    printf "\n${BOLD}${BLUE}==>${RESET} ${BOLD}%s${RESET}\n" "$1"
}

print_success() {
    printf "${GREEN}✓${RESET} %s\n" "$1"
}

print_error() {
    printf "${RED}✗${RESET} %s\n" "$1" >&2
}

print_warning() {
    printf "${YELLOW}⚠${RESET} %s\n" "$1"
}

print_info() {
    printf "${CYAN}ℹ${RESET} %s\n" "$1"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

confirm() {
    local prompt="${1:-Continue?}"
    local default="${2:-n}"

    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n]: "
    else
        prompt="$prompt [y/N]: "
    fi

    read -r -p "$prompt" response

    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        [nN][oO]|[nN]) return 1 ;;
        "")
            if [[ "$default" == "y" ]]; then
                return 0
            else
                return 1
            fi
            ;;
        *) return 1 ;;
    esac
}

die() {
    print_error "$1"
    exit 1
}

init_paths() {
    PACKAGES_DIR="${DOTFILES_DIR}/packages"
    HOME_DIR="${DOTFILES_DIR}/home"
}

ensure_dotfiles_dir() {
    if [[ "$NO_CLONE" == true ]]; then
        if [[ ! -d "$DOTFILES_DIR" ]]; then
            die "Dotfiles directory not found: ${DOTFILES_DIR}"
        fi
        return 0
    fi

    if [[ -d "${DOTFILES_DIR}/.git" ]]; then
        return 0
    fi

    if [[ "$DOTFILES_DIR" == "$SCRIPT_DIR" ]]; then
        die "Script is not inside a git repo. Use --dotfiles-dir to clone into a target path or pass --no-clone."
    fi

    print_header "Cloning dotfiles"
    if [[ -d "$DOTFILES_DIR" ]]; then
        die "Target directory exists but is not a git repo: ${DOTFILES_DIR}"
    fi

    if ! command_exists git; then
        die "git is required to clone the dotfiles repository"
    fi

    print_info "Cloning ${DOTFILES_REPO_URL} to ${DOTFILES_DIR}..."
    if git clone "$DOTFILES_REPO_URL" "$DOTFILES_DIR"; then
        print_success "Dotfiles cloned"
    else
        die "Failed to clone dotfiles"
    fi
}

install_tools() {
    if [[ "$SKIP_TOOLS" == true ]]; then
        print_info "Skipping tools installation"
        return 0
    fi

    local tools_script="${DOTFILES_DIR}/modules/tools.sh"
    if [[ -f "$tools_script" ]]; then
        print_header "Installing tools"
        # shellcheck disable=SC1090
        source "$tools_script"
        print_success "Tools installation complete"
    else
        print_warning "Tools script not found at ${tools_script}"
    fi
}

stow_dotfiles() {
    if [[ "$SKIP_STOW" == true ]]; then
        print_info "Skipping stow"
        return 0
    fi

    if ! command_exists stow; then
        print_warning "GNU stow not found. Skipping ~/.config symlink management."
        print_info "Install stow for automatic ~/.config management: brew install stow"
        print_info "Or manually copy files from ${DOTFILES_DIR}/home/.config/ to ~/.config/"
        return 0
    fi

    if [[ ! -d "$HOME_DIR" ]]; then
        print_warning "No home directory to stow at ${HOME_DIR}"
        return 0
    fi

    print_header "Stowing configuration files"

    if [[ -d "$HOME/.config" && ! -L "$HOME/.config" ]]; then
        local backup_config
        backup_config="$HOME/.config.backup.$(date +%Y%m%d_%H%M%S)"
        print_info "Backing up existing ~/.config to ${backup_config}"
        cp -r "$HOME/.config" "$backup_config"
    fi

    if stow --target="$HOME" --no-folding -d "$DOTFILES_DIR" home; then
        print_success "Successfully stowed ~/.config"
    else
        print_warning "Stow command failed. You may need to manually manage ~/.config"
    fi
}

setup_shell() {
    if [[ "$SKIP_SHELL" == true ]]; then
        print_info "Skipping shell setup"
        return 0
    fi

    local zshrc="$HOME/.zshrc"
    local dotfiles_line='source "$HOME/dotfiles/shell/zsh.sh"'

    print_header "Configuring shell"

    if [[ -f "$zshrc" ]]; then
        if grep -q "$dotfiles_line" "$zshrc"; then
            print_success ".zshrc already sources dotfiles"
            return 0
        fi
        local backup_file
        backup_file="$HOME/.zshrc.backup.$(date +%Y%m%d_%H%M%S)"
        print_info "Backing up existing .zshrc to ${backup_file}"
        cp "$zshrc" "$backup_file"
    fi

    print_info "Appending dotfiles to .zshrc"
    {
        printf "\n# Dotfiles\n"
        printf "%s\n" "$dotfiles_line"
    } >>"$zshrc"
    print_success "Shell configured"
}

chmod_bin_scripts() {
    local bin_dir="${DOTFILES_DIR}/bin"
    if [[ -d "$bin_dir" ]]; then
        print_header "Making bin scripts executable"
        shopt -s nullglob
        local scripts=("$bin_dir"/*.sh)
        shopt -u nullglob
        if [[ ${#scripts[@]} -gt 0 ]]; then
            chmod +x "${scripts[@]}"
            print_success "Updated executable permissions"
        else
            print_info "No .sh scripts found in ${bin_dir}"
        fi
    fi
}

cmd_init() {
    print_header "Initializing dotfiles"
    ensure_dotfiles_dir
    init_paths
    install_tools
    stow_dotfiles
    setup_shell
    chmod_bin_scripts
    print_header "Initialization complete!"
    print_info "Restart your terminal or run: source ~/.zshrc"
}

cmd_update() {
    print_header "Updating dotfiles"
    ensure_dotfiles_dir
    init_paths

    if [[ -d "${DOTFILES_DIR}/.git" ]]; then
        if ! command_exists git; then
            die "git is required to update the repository"
        fi
        print_info "Pulling latest changes..."
        if git -C "$DOTFILES_DIR" pull --ff-only; then
            print_success "Repository updated"
        else
            die "Failed to update repository"
        fi
    else
        print_warning "No git repository found at ${DOTFILES_DIR}"
    fi

    stow_dotfiles
    print_success "Update complete"
}

cmd_doctor() {
    print_header "Running diagnostics"
    local issues=0

    if command_exists git; then
        print_success "git available"
    else
        print_error "git not found"
        ((++issues))
    fi

    if command_exists stow; then
        print_success "GNU stow installed"
    else
        print_warning "GNU stow not installed"
    fi

    if [[ -d "$DOTFILES_DIR" ]]; then
        print_success "Dotfiles directory: ${DOTFILES_DIR}"
    else
        print_error "Dotfiles directory missing: ${DOTFILES_DIR}"
        ((++issues))
    fi

    if [[ -f "$HOME/.zshrc" ]]; then
        local dotfiles_line='source "$HOME/dotfiles/shell/zsh.sh"'
        if grep -q "$dotfiles_line" "$HOME/.zshrc"; then
            print_success ".zshrc sources dotfiles"
        else
            print_warning ".zshrc does not source dotfiles"
        fi
    else
        print_warning "~/.zshrc not found"
    fi

    if [[ $issues -eq 0 ]]; then
        print_header "All critical checks passed"
    else
        print_header "Found ${issues} critical issues"
    fi
}

cmd_stow() {
    ensure_dotfiles_dir
    init_paths
    stow_dotfiles
}

cmd_link() {
    print_header "Creating symlink for dot command"

    local target_dir="/usr/local/bin"
    local link_path="${target_dir}/dot"

    if [[ ! -w "$target_dir" ]]; then
        target_dir="${HOME}/.local/bin"
        link_path="${target_dir}/dot"
        mkdir -p "$target_dir"
        print_info "Using ${target_dir}"
    fi

    if [[ -L "$link_path" ]]; then
        rm "$link_path"
    fi

    if ln -s "${DOTFILES_DIR}/dot" "$link_path"; then
        print_success "Created symlink at ${link_path}"
        print_info "Make sure ${target_dir} is in your PATH"
    else
        die "Failed to create symlink"
    fi
}

cmd_unlink() {
    print_header "Removing dot symlink"
    local paths=(
        "/usr/local/bin/dot"
        "${HOME}/.local/bin/dot"
    )

    local found=false
    for link_path in "${paths[@]}"; do
        if [[ -L "$link_path" ]]; then
            rm "$link_path"
            print_success "Removed symlink at ${link_path}"
            found=true
        fi
    done

    if [[ "$found" == false ]]; then
        print_warning "No dot symlink found"
    fi
}

cmd_help() {
    printf "${BOLD}%s${RESET} - Dotfiles management tool\n" "$SCRIPT_NAME"
    printf "Version: %s\n\n" "$VERSION"

    printf "${BOLD}USAGE:${RESET}\n"
    printf "    %s [OPTIONS] COMMAND [ARGS]\n\n" "$SCRIPT_NAME"

    printf "${BOLD}COMMANDS:${RESET}\n"
    printf "    init                Initialize and install dotfiles\n"
    printf "    update              Update dotfiles and re-stow configs\n"
    printf "    doctor              Run diagnostics and check installation\n"
    printf "    stow                Create symlinks for dotfiles using GNU Stow\n"
    printf "    link                Install dot command globally (create symlink in PATH)\n"
    printf "    unlink              Uninstall global dot command (remove symlink)\n"
    printf "    help                Show this help message (default)\n\n"

    printf "${BOLD}OPTIONS:${RESET}\n"
    printf "    --dotfiles-dir PATH  Override dotfiles directory (default: script location)\n"
    printf "    --no-clone           Do not attempt to clone the repository\n"
    printf "    --skip-tools         Skip tools installation (modules/tools.sh)\n"
    printf "    --skip-stow          Skip stowing ~/.config files\n"
    printf "    --skip-shell         Skip .zshrc configuration\n"
    printf "    --version            Show version information\n"
    printf "    -h, --help           Show this help message\n\n"

    printf "${BOLD}EXAMPLES:${RESET}\n"
    printf "    %s init\n" "$SCRIPT_NAME"
    printf "    %s init --skip-tools\n" "$SCRIPT_NAME"
    printf "    %s update --skip-stow\n" "$SCRIPT_NAME"
    printf "    %s stow\n" "$SCRIPT_NAME"
    printf "    %s link\n" "$SCRIPT_NAME"
    printf "\n"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dotfiles-dir)
                DOTFILES_DIR="$2"
                shift 2
                ;;
            --no-clone)
                NO_CLONE=true
                shift
                ;;
            --skip-tools)
                SKIP_TOOLS=true
                shift
                ;;
            --skip-stow)
                SKIP_STOW=true
                shift
                ;;
            --skip-shell)
                SKIP_SHELL=true
                shift
                ;;
            --version)
                printf "%s version %s\n" "$SCRIPT_NAME" "$VERSION"
                exit 0
                ;;
            -h|--help)
                cmd_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)
            cmd_init "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        stow)
            cmd_stow "$@"
            ;;
        link)
            cmd_link "$@"
            ;;
        unlink)
            cmd_unlink "$@"
            ;;
        help)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $cmd"
            printf "Run '%s help' for usage information\n" "$SCRIPT_NAME"
            exit 1
            ;;
    esac
}

main "$@"
