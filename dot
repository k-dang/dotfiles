#!/usr/bin/env bash

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'
readonly BOLD='\033[1m'

# Script metadata
readonly SCRIPT_NAME="dot"
readonly VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Defaults (can be overridden by flags)
DOTFILES_DIR="$SCRIPT_DIR"
SKILL_DIRS=(".claude/skills" ".agents/skills")

# Single source of truth for the skills add invocation. Referenced by the command
# itself, the argument dispatcher, and the top-level help so they cannot drift.
readonly SKILLS_ADD_USAGE="${SCRIPT_NAME} skills add <url> [--force] [--agents-only|--claude-only] [--all] [--dry-run] [--skill=NAME]"

print_header() {
    printf "\n${BOLD}${BLUE}==>${RESET} ${BOLD}%s${RESET}\n" "$1"
}

print_success() {
    printf "${GREEN}✓${RESET} %s\n" "$1"
}

print_error() {
    printf "${RED}✗${RESET} %s\n" "$1" >&2
}

print_warning() {
    printf "${YELLOW}⚠${RESET} %s\n" "$1"
}

print_info() {
    printf "${CYAN}ℹ${RESET} %s\n" "$1"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

die() {
    print_error "$1"
    exit 1
}

install_tools() {
    local tools_script="${DOTFILES_DIR}/modules/tools.sh"
    if [[ -f "$tools_script" ]]; then
        print_header "Installing tools"
        # shellcheck disable=SC1090
        source "$tools_script"
        print_success "Tools installation complete"
    else
        print_warning "Tools script not found at ${tools_script}"
    fi
}

stow_dotfiles() {
    local mode="${1:-routine}"
    local home_dir="${DOTFILES_DIR}/home"

    if ! command_exists stow; then
        print_warning "GNU stow not found. Skipping ~/.config symlink management."
        print_info "Install stow for automatic ~/.config management: brew install stow"
        print_info "Or manually copy files from ${DOTFILES_DIR}/home/.config/ to ~/.config/"
        return 0
    fi

    if [[ ! -d "$home_dir" ]]; then
        print_warning "No home directory to stow at ${home_dir}"
        return 0
    fi

    print_header "Stowing configuration files"

    # Stow only manages paths present under home/. Init performs a non-destructive
    # initial stow and fails on conflicts with existing real files. Routine runs
    # use `--restow` to refresh symlinks already managed by stow. Unrelated files
    # in ~/.config are left alone.

    local stow_args=(--target="$HOME" --no-folding -d "$DOTFILES_DIR")

    if [[ "$mode" != "init" ]]; then
        stow_args+=(--restow)
    fi

    if stow "${stow_args[@]}" home; then
        print_success "Successfully stowed dotfiles from ${home_dir}"
    else
        print_warning "Stow command failed, likely due to an existing conflicting file in \$HOME"
        print_info "Resolve the conflict manually, then rerun: ${SCRIPT_NAME} stow"
    fi
}

setup_shell() {
    local zshrc="$HOME/.zshrc"
    local dotfiles_line='source "$HOME/dotfiles/shell/zsh.sh"'

    print_header "Configuring shell"

    if [[ -f "$zshrc" ]]; then
        if grep -q "$dotfiles_line" "$zshrc"; then
            print_success ".zshrc already sources dotfiles"
            return 0
        fi
        local backup_file
        backup_file="$HOME/.zshrc.backup.$(date +%Y%m%d_%H%M%S)"
        print_info "Backing up existing .zshrc to ${backup_file}"
        cp "$zshrc" "$backup_file"
    fi

    print_info "Appending dotfiles to .zshrc"
    {
        printf "\n# Dotfiles\n"
        printf "%s\n" "$dotfiles_line"
    } >>"$zshrc"
    print_success "Shell configured"
}

chmod_bin_scripts() {
    local bin_dir="${DOTFILES_DIR}/bin"
    if [[ -d "$bin_dir" ]]; then
        print_header "Making bin scripts executable"
        shopt -s nullglob
        local scripts=("$bin_dir"/*.sh)
        shopt -u nullglob
        if [[ ${#scripts[@]} -gt 0 ]]; then
            chmod +x "${scripts[@]}"
            print_success "Updated executable permissions"
        else
            print_info "No .sh scripts found in ${bin_dir}"
        fi
    fi
}

cmd_init() {
    print_header "Initializing dotfiles"
    install_tools
    stow_dotfiles init
    setup_shell
    chmod_bin_scripts
    print_header "Initialization complete!"
    print_info "Restart your terminal or run: source ~/.zshrc"
}

cmd_doctor() {
    print_header "Running diagnostics"
    local issues=0

    if command_exists git; then
        print_success "git available"
    else
        print_error "git not found"
        ((++issues))
    fi

    if command_exists stow; then
        print_success "GNU stow installed"
    else
        print_warning "GNU stow not installed"
    fi

    if [[ -d "$DOTFILES_DIR" ]]; then
        print_success "Dotfiles directory: ${DOTFILES_DIR}"
    else
        print_error "Dotfiles directory missing: ${DOTFILES_DIR}"
        ((++issues))
    fi

    if [[ -f "$HOME/.zshrc" ]]; then
        local dotfiles_line='source "$HOME/dotfiles/shell/zsh.sh"'
        if grep -q "$dotfiles_line" "$HOME/.zshrc"; then
            print_success ".zshrc sources dotfiles"
        else
            print_warning ".zshrc does not source dotfiles"
        fi
    else
        print_warning "~/.zshrc not found"
    fi

    if [[ $issues -eq 0 ]]; then
        print_header "All critical checks passed"
    else
        print_header "Found ${issues} critical issues"
    fi
}

cmd_stow() {
    stow_dotfiles routine
}

# Reads the `description:` key out of a SKILL.md YAML frontmatter. Only the
# simple one-line form is handled; a folded (> or |) block is reported as-is,
# which is still more useful in a picker than no description at all. The closing
# --- is the only terminator: every other frontmatter key is unindented.
get_skill_description() {
    local file="$1/SKILL.md"
    [[ -f "$file" ]] || return 0

    local line desc="" in_fm=0 seen_fence=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^---[[:space:]]*$ ]]; then
            if ((seen_fence == 0)); then
                in_fm=1
                seen_fence=1
                continue
            fi
            break
        fi
        ((in_fm == 1)) || continue
        if [[ "$line" =~ ^description[[:space:]]*:[[:space:]]*(.*)$ ]]; then
            desc="${BASH_REMATCH[1]}"
            desc="${desc#"${desc%%[![:space:]]*}"}"   # trim leading space
            desc="${desc%"${desc##*[![:space:]]}"}"   # trim trailing space
            desc="${desc%\"}"; desc="${desc#\"}"
            desc="${desc%\'}"; desc="${desc#\'}"
            printf '%s' "$desc"
            return 0
        fi
    done <"$file"
}

# "name  description" on one line, whitespace squeezed and truncated so the
# picker stays readable when descriptions run long.
format_skill_label() {
    local name="$1" desc="$2"
    [[ -n "$desc" ]] || { printf '%s' "$name"; return 0; }

    desc="$(printf '%s' "$desc" | tr '\n\r\t' '   ' | tr -s ' ')"
    desc="${desc#"${desc%%[![:space:]]*}"}"
    desc="${desc%"${desc##*[![:space:]]}"}"

    if ((${#desc} > 72)); then
        desc="${desc:0:69}..."
    fi
    printf '%s  %s' "$name" "$desc"
}

# Destructive steps ask first, but only when a human is there to answer. With
# stdin redirected (a script, a CI job) prompting would hang, so --force stands
# on its own and this returns success.
confirm_destructive_action() {
    local verb="$1" count="$2" subject="$3"
    [[ -t 0 ]] || return 0

    local noun="$subject"
    ((count != 1)) && noun="${subject}s"

    local reply
    while true; do
        read -rp "${verb} ${count} existing ${noun}? [y/N] " reply || reply=""
        reply="${reply,,}"
        reply="${reply#"${reply%%[![:space:]]*}"}"
        [[ -z "$reply" ]] && return 1
        case "$reply" in
            y|yes) return 0 ;;
            n|no) return 1 ;;
            *) print_warning "Please answer y or n." ;;
        esac
    done
}

cmd_skills_add() {
    local url=""
    local force=false
    local agents_only=false
    local claude_only=false
    local install_all=false
    local dry_run=false
    local -a wanted=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=true; shift ;;
            --agents-only) agents_only=true; shift ;;
            --claude-only) claude_only=true; shift ;;
            --all) install_all=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            --skill=*) wanted+=("${1#--skill=}"); shift ;;
            -h|--help)
                printf "USAGE:\n"
                printf "    %s\n" "$SKILLS_ADD_USAGE"
                printf "\n    <url>  GitHub tree URL with one skill or multiple skill directories\n"
                printf "           e.g. https://github.com/owner/repo/tree/main/skills\n"
                printf "\n    Prompts for which skills to install unless --all or --skill=NAME is given.\n"
                printf "\n    --force  Replace skills that are already installed (asks first on a terminal)\n"
                return 0
                ;;
            --*) print_error "Unknown option for skills add: $1"; return 1 ;;
            *)
                if [[ -z "$url" ]]; then url="$1"; shift
                else print_error "Unexpected argument for skills add: $1"; return 1
                fi
                ;;
        esac
    done

    if [[ "$agents_only" == true && "$claude_only" == true ]]; then
        die "Options --agents-only and --claude-only are mutually exclusive"
    fi
    if [[ -z "$url" ]]; then
        die "Missing required <url>. Usage: $SKILLS_ADD_USAGE"
    fi
    if [[ "$install_all" == true && "${#wanted[@]}" -gt 0 ]]; then
        die "Options --all and --skill cannot be combined"
    fi

    # Parse https://github.com/<owner>/<repo>/tree/<ref>/<path...>
    local path_part="$url"
    path_part="${path_part#https://github.com/}"
    path_part="${path_part#https://www.github.com/}"
    path_part="${path_part#http://github.com/}"
    if [[ "$path_part" == "$url" ]]; then
        die "Expected a GitHub URL like https://github.com/owner/repo/tree/ref/path"
    fi
    local owner="${path_part%%/*}"
    local rest="${path_part#*/}"
    local repo="${rest%%/*}"
    rest="${rest#*/}"
    repo="${repo%.git}"
    local view="${rest%%/*}"
    rest="${rest#*/}"
    local ref="${rest%%/*}"
    local tree_path="${rest#*/}"
    if [[ -z "$owner" || -z "$repo" || "$view" != "tree" || -z "$ref" || -z "$tree_path" || "$tree_path" == "$rest" ]]; then
        die "URL must point to a file tree or skill directory (.../tree/<ref>/<path>)"
    fi

    local agents_root="$DOTFILES_DIR/home/.agents/skills"
    local claude_root="$DOTFILES_DIR/home/.claude/skills"
    local -a dest_labels=()
    local -a dest_roots=()
    if [[ "$claude_only" != true ]]; then dest_labels+=(".agents"); dest_roots+=("$agents_root"); fi
    if [[ "$agents_only" != true ]]; then dest_labels+=(".claude"); dest_roots+=("$claude_root"); fi

    command_exists curl || die "curl is required for skills add"
    command_exists unzip || die "unzip is required for skills add"

    local tmpdir
    tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-skills-XXXXXX")"
    trap 'rm -rf "${tmpdir:-}"' EXIT

    print_info "Downloading $owner/$repo@$ref..."
    curl -fsSL -A "dotfiles-skills-add" -o "$tmpdir/repository.zip" \
        "https://codeload.github.com/$owner/$repo/zip/$ref"

    mkdir -p "$tmpdir/extracted"
    unzip -q "$tmpdir/repository.zip" -d "$tmpdir/extracted"

    local -a roots=("$tmpdir/extracted"/*/)
    if [[ "${#roots[@]}" -ne 1 ]]; then
        die "GitHub archive has an unexpected structure"
    fi
    local source="${roots[0]}${tree_path}"
    [[ -d "$source" ]] || die "Path not found in repository: $tree_path"

    local -a skills=()
    if [[ -f "$source/SKILL.md" ]]; then
        skills=("$source")
    else
        local d
        for d in "$source"/*/; do
            [[ -d "$d" ]] || continue
            [[ -f "${d}SKILL.md" ]] || continue
            skills+=("${d%/}")
        done
    fi
    if [[ "${#skills[@]}" -eq 0 ]]; then
        die "No skill directories (containing SKILL.md) found under $tree_path"
    fi

    # Names and labels are built once so --skill=, the gum picker, and the
    # numbered prompt all agree on what a skill is called.
    local -a skill_names=() skill_labels=()
    local s desc
    for s in "${skills[@]}"; do
        desc="$(get_skill_description "$s")"
        skill_names+=("$(basename "$s")")
        skill_labels+=("$(format_skill_label "$(basename "$s")" "$desc")")
    done

    local -a selected=()
    local i w found prompt_for_selection=false
    if [[ "${#wanted[@]}" -gt 0 ]]; then
        for w in "${wanted[@]}"; do
            found=false
            for i in "${!skills[@]}"; do
                if [[ "${skill_names[$i]}" == "$w" ]]; then selected+=("${skills[$i]}"); found=true; break; fi
            done
            [[ "$found" == true ]] || die "Skill not found in archive: $w"
        done
    elif [[ "$install_all" == true ]]; then
        selected=("${skills[@]}")
    else
        # Interactive is the default: --all and --skill= are the opt-outs.
        prompt_for_selection=true
    fi

    if $prompt_for_selection; then
        # gum needs a real terminal. With stdin redirected it would block
        # forever, so fall through to the numbered prompt, which reads a pipe
        # just fine.
        if command_exists gum && [[ -t 0 ]]; then
            local chosen line
            chosen="$(printf '%s\n' "${skill_labels[@]}" | gum choose --no-limit --header "Select skills to install")"
            if [[ -n "$chosen" ]]; then
                while IFS= read -r line; do
                    [[ -z "$line" ]] && continue
                    for i in "${!skills[@]}"; do
                        if [[ "${skill_labels[$i]}" == "$line" ]]; then selected+=("${skills[$i]}"); break; fi
                    done
                done <<<"$chosen"
            fi
        else
            print_info "gum unavailable or stdin redirected; falling back to numbered prompt (or rerun with --all / --skill=NAME)."
            local n
            for n in "${!skills[@]}"; do printf '  [%d] %s\n' "$((n + 1))" "${skill_labels[$n]}"; done

            # Re-prompt on bad input instead of aborting: the download has
            # already happened, so losing the whole run to a typo is the wrong
            # trade.
            local answer token bad
            local -a tokens=() picked=()
            while true; do
                read -rp "Enter numbers comma-separated, 'all', or blank to cancel: " answer || answer=""
                [[ -z "${answer// }" ]] && { selected=(); break; }
                if [[ "${answer,,}" == "all" ]]; then
                    selected=("${skills[@]}")
                    break
                fi

                picked=()
                bad=""
                IFS=',' read -ra tokens <<<"$answer"
                for token in "${tokens[@]}"; do
                    token="${token// /}"
                    if [[ "$token" =~ ^[0-9]+$ && "$token" -ge 1 && "$token" -le "${#skills[@]}" ]]; then
                        picked+=("${skills[$((token - 1))]}")
                    else
                        bad="$token"
                        break
                    fi
                done
                if [[ -n "$bad" ]]; then
                    print_warning "Not a valid selection: '$bad'. Pick 1-${#skills[@]}, or 'all'."
                    continue
                fi
                selected=("${picked[@]}")
                break
            done
        fi
    fi

    if [[ "${#selected[@]}" -eq 0 ]]; then
        print_info "No skills selected."
        return 0
    fi

    # Resolve every target before writing anything, so a single confirmation
    # can cover the whole run instead of one prompt per file.
    local -a plan_action=() plan_target=() plan_source=() plan_qualified=()
    local replace_count=0
    local skill name target action
    for skill in "${selected[@]}"; do
        name="$(basename "$skill")"
        for i in "${!dest_roots[@]}"; do
            target="${dest_roots[$i]}/${name}"
            if [[ ! -e "$target" ]]; then
                action=install
            elif [[ "$force" == true ]]; then
                action=replace
                ((++replace_count))
            else
                action=skip
            fi
            plan_action+=("$action")
            plan_target+=("$target")
            plan_source+=("$skill")
            plan_qualified+=("$name (${dest_labels[$i]})")
        done
    done

    if [[ "$replace_count" -gt 0 ]] && ! $dry_run; then
        if ! confirm_destructive_action "Replace" "$replace_count" "skill"; then
            print_info "Cancelled; nothing was installed."
            trap - EXIT
            rm -rf "$tmpdir"
            return 0
        fi
    fi

    if ! $dry_run; then
        for i in "${!dest_roots[@]}"; do mkdir -p "${dest_roots[$i]}"; done
    fi

    local -a installed=() skipped=()
    for i in "${!plan_action[@]}"; do
        action="${plan_action[$i]}"
        if [[ "$action" == "skip" ]]; then
            skipped+=("${plan_qualified[$i]}")
            continue
        fi
        if $dry_run; then
            print_info "[dry-run] would ${action} ${plan_target[$i]}"
            installed+=("${plan_qualified[$i]}")
            continue
        fi
        rm -rf "${plan_target[$i]}"
        cp -R "${plan_source[$i]}" "${plan_target[$i]}"
        installed+=("${plan_qualified[$i]}")
    done

    if [[ "${#installed[@]}" -gt 0 ]]; then
        if $dry_run; then
            print_success "Dry run would install ${#installed[@]}: ${installed[*]}"
        else
            print_success "Installed ${#installed[@]}: ${installed[*]}"
        fi
    fi
    if [[ "${#skipped[@]}" -gt 0 ]]; then
        print_warning "Skipped ${#skipped[@]} existing: ${skipped[*]}"
        print_info "Run again with --force to replace them."
    fi
    if $dry_run; then
        print_info "No files were changed"
    else
        print_info 'Next: run `./dot stow` on macOS or `.\dot.ps1 sync` on Windows to deploy to $HOME.'
    fi
    trap - EXIT
    rm -rf "$tmpdir"
}

# A skill is stale when it is installed under $HOME but missing from home/. Without
# a source directory there is nothing to compare against, so nothing is stale.
is_stale_skill() {
    local source="${DOTFILES_DIR}/home/$1"
    [[ -d "$source" && -e "${HOME}/$1/$2" && ! -e "${source}/$2" ]]
}

# Prints one line per stale skill: the name padded to a column, then the
# top-level directories (.claude, .agents) it is installed in.
list_stale_skills() {
    local rel dir name
    for rel in "${SKILL_DIRS[@]}"; do
        # The glob skips dot-prefixed folders such as .trash, which are not skills.
        for dir in "${HOME}/${rel}"/*/; do
            name="$(basename "$dir")"
            if is_stale_skill "$rel" "$name"; then
                printf "%s\t%s\n" "$name" "${rel%%/*}"
            fi
        done
    done | sort | awk -F'\t' '
        !($1 in locations) { names[n++] = $1; locations[$1] = $2; if (length($1) > width) width = length($1); next }
        { locations[$1] = locations[$1] " " $2 }
        END { for (i = 0; i < n; i++) printf "%-" width "s  %s\n", names[i], locations[names[i]] }
    '
}

cmd_prune() {
    local dry_run=false
    case "${1:-}" in
        "") ;;
        --dry-run) dry_run=true ;;
        *) die "Unexpected argument for prune: $1" ;;
    esac

    print_header "Finding skills not in home/"

    local stale
    stale="$(list_stale_skills)"
    if [[ -z "$stale" ]]; then
        print_success "No stale skills found"
        return 0
    fi

    if $dry_run; then
        printf "%s\n" "$stale" | sed 's/^/  /'
        print_info "No files were deleted"
        return 0
    fi

    command_exists gum || die "gum not found. Install it with: brew install gum"

    local chosen
    chosen="$(printf "%s\n" "$stale" | gum choose --no-limit --header "Select skills to delete")" || true
    if [[ -z "$chosen" ]]; then
        print_info "No skills deleted"
        return 0
    fi

    local count=0 label name rel
    while IFS= read -r label; do
        name="${label%% *}"
        for rel in "${SKILL_DIRS[@]}"; do
            if is_stale_skill "$rel" "$name"; then
                rm -rf "${HOME:?}/${rel}/${name}"
            fi
        done
        ((++count))
    done <<<"$chosen"

    print_success "Deleted ${count} skill(s)"
}

cmd_help() {
    printf "${BOLD}%s${RESET} - Dotfiles management tool\n" "$SCRIPT_NAME"
    printf "Version: %s\n\n" "$VERSION"

    printf "${BOLD}USAGE:${RESET}\n"
    printf "    %s [OPTIONS] COMMAND [ARGS]\n\n" "$SCRIPT_NAME"

    printf "${BOLD}COMMANDS:${RESET}\n"
    printf "    init                Initialize dotfiles without adopting existing config files\n"
    printf "    doctor              Run diagnostics and check installation\n"
    printf "    stow                Create symlinks for dotfiles using GNU Stow\n"
    printf "    skills add <url>    Download skills from a GitHub tree URL into home/.agents/skills and home/.claude/skills\n"
    printf "                        (prompts unless --all / --skill=NAME; see '%s skills add --help')\n" "$SCRIPT_NAME"
    printf "    prune [--dry-run]   Pick installed skills that are not in home/ to delete\n"
    printf "    help                Show this help message (default)\n\n"

    printf "${BOLD}OPTIONS:${RESET}\n"
    printf "    --dotfiles-dir PATH  Override dotfiles directory (default: script location)\n"
    printf "    --version            Show version information\n"
    printf "    -h, --help           Show this help message\n\n"

    printf "${BOLD}EXAMPLES:${RESET}\n"
    printf "    %s init\n" "$SCRIPT_NAME"
    printf "    %s stow\n" "$SCRIPT_NAME"
    printf "    %s skills add https://github.com/owner/repo/tree/main/skills --all\n" "$SCRIPT_NAME"
    printf "\n"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dotfiles-dir)
                DOTFILES_DIR="$2"
                shift 2
                ;;
            --version)
                printf "%s version %s\n" "$SCRIPT_NAME" "$VERSION"
                exit 0
                ;;
            -h|--help)
                cmd_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)
            cmd_init "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        stow)
            cmd_stow "$@"
            ;;
        skills)
            local sub="${1:-}"
            shift || true
            # `skills --help` and `skills` on their own should print the skills add
            # usage rather than the usage error, matching the other commands.
            if [[ -z "$sub" ]]; then sub="add"; set -- --help "$@"; fi
            if [[ "$sub" == "-h" || "$sub" == "--help" ]]; then sub="add"; set -- --help "$@"; fi
            if [[ "$sub" != "add" ]]; then
                print_error "Usage: $SKILLS_ADD_USAGE"
                exit 1
            fi
            cmd_skills_add "$@"
            ;;
        prune)
            cmd_prune "$@"
            ;;
        help)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $cmd"
            printf "Run '%s help' for usage information\n" "$SCRIPT_NAME"
            exit 1
            ;;
    esac
}

main "$@"
