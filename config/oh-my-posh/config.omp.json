{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#8CAAEE",
    "closer": "p:os",
    "lavender": "#BABBF1",
    "os": "#ACB0BE",
    "pink": "#F4B8E4"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": true
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{.Icon}} ",
          "foreground": "p:os",
          "type": "os",
          "style": "plain"
        },
        {
          "template": "{{ .UserName }} ",
          "foreground": "p:blue",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": "{{ .Path }} ",
          "foreground": "p:pink",
          "type": "path",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "{{ .HEAD }} ",
          "foreground": "p:lavender",
          "type": "git",
          "style": "plain"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#6CA35E",
          "template": "{{ if not (glob \"bun.lock\") }} {{ .Full }} {{ end }}"
        },
        {
          "type": "ruby",
          "style": "plain",
          "foreground": "#E0115F",
          "template": " {{ .Full }} "
        },
        {
          "type": "bun",
          "style": "plain",
          "foreground": "#3C82F6",
          "template": " {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#ffd43b",
          "template": " {{ .Full }} "
        },
        {
          "template": "\uf105",
          "foreground": "p:closer",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
